      "type": "React.ReactNode",
      "required": false,
      "defaultValue": null
    },
    {
      "name": "rightIcon",
      "type": "React.ReactNode",
      "required": false,
      "defaultValue": null
    },
    {
      "name": "onChange",
      "type": "React.ChangeEventHandler<HTMLInputElement>",
      "required": false,
      "defaultValue": null
    },
    {
      "name": "value",
      "type": "string",
      "required": false,
      "defaultValue": null
    }
