{
  "componentName": "Tooltip",
  "props": [
    {
      "name": "content",
      "type": "string",
      "required": true,
      "defaultValue": null
    },
    {
      "name": "children",
      "type": "React.ReactNode",
      "required": true,
      "defaultValue": null
    },
    {
      "name": "variant",
      "type": "\"dark\" | \"light\"",
      "required": false,
      "defaultValue": "dark"
    },
    {
      "name": "size",
      "type": "\"sm\" | \"md\" | \"lg\"",
      "required": false,
      "defaultValue": "md"
    },
    {
      "name": "placement",
      "type": "\"top\" | \"bottom\" | \"left\" | \"right\"",
      "required": false,
      "defaultValue": "top"
    },
    {
      "name": "showArrow",
      "type": "boolean",
      "required": false,
      "defaultValue": null
    },
    {
      "name": "maxWidth",
      "type": "string",
      "required": false,
      "defaultValue": null
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "defaultValue": null
    }
  ]
}