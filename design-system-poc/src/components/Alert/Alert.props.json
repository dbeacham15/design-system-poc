{
  "componentName": "Alert",
  "props": [
    {
      "name": "variant",
      "type": "\"info\" | \"success\" | \"warning\" | \"error\"",
      "required": false,
      "defaultValue": "info"
    },
    {
      "name": "size",
      "type": "\"sm\" | \"md\" | \"lg\"",
      "required": false,
      "defaultValue": "md"
    },
    {
      "name": "title",
      "type": "string",
      "required": false,
      "defaultValue": "Alert"
    },
    {
      "name": "byline",
      "type": "string",
      "required": false,
      "defaultValue": "This is a secondary line of supporting text."
    },
    {
      "name": "icon",
      "type": "React.ReactNode",
      "required": false,
      "defaultValue": null
    },
    {
      "name": "onClose",
      "type": "() => void",
      "required": false,
      "defaultValue": null
    },
    {
      "name": "fullWidth",
      "type": "boolean",
      "required": false,
      "defaultValue": null
    }
  ]
}