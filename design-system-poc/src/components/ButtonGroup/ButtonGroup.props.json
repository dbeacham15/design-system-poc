{
  "componentName": "ButtonGroup",
  "props": [
    {
      "name": "variant",
      "type": "\"outlined\" | \"filled\"",
      "required": false,
      "defaultValue": "outlined"
    },
    {
      "name": "size",
      "type": "\"sm\" | \"md\" | \"lg\"",
      "required": false,
      "defaultValue": "md"
    },
    {
      "name": "options",
      "type": "{ label: string; value: string; icon?: React.ReactNode }[]",
      "required": true,
      "defaultValue": null
    },
    {
      "name": "value",
      "type": "string",
      "required": false,
      "defaultValue": null
    },
    {
      "name": "onChange",
      "type": "(value: string) => void",
      "required": false,
      "defaultValue": null
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "defaultValue": null
    },
    {
      "name": "fullWidth",
      "type": "boolean",
      "required": false,
      "defaultValue": null
    }
  ]
}